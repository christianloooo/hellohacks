PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
TIME_ZONE=America/Vancouver

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Required for AI-generated activities. Keep this key server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local prototype only. Set false in production.
DEMO_MODE=true

# Hosting: use one HTTPS origin for the website and API.
# On Railway the public origin is inferred from RAILWAY_PUBLIC_DOMAIN.
# Remove the localhost URL overrides above when deploying there.
# Mount a persistent volume at /data and run exactly one replica.
# DATA_DIR=/data
# NODE_ENV=production
# DEMO_MODE=false
